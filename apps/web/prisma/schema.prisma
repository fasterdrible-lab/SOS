generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── MULTIEMPRESA ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(TRIAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         OrganizationMember[]
  leads           Lead[]
  companies       Company[]
  contacts        Contact[]
  opportunities   Opportunity[]
  activities      Activity[]
  diagnostics     Diagnostic[]
  actionPlans     ActionPlan[]
  apiIntegrations ApiIntegration[]
  sdrConversations SdrConversation[]
  consultantConversation ConsultantConversation?
  auditLogs       AuditLog[]
  opportunityStageHistory OpportunityStageHistory[]
  salesGoals      SalesGoal[]
  pipelines       Pipeline[]
  pipelineStages  PipelineStage[]
  saleiaIntegration SaleiaIntegration?
  saleiaMeetings  SaleiaMeeting[]
  saleiaInsights  SaleiaInsight[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// ─── AUTENTICAÇÃO ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  members  OrganizationMember[]
  ownedOpportunities Opportunity[]
  ownedActivities Activity[]
  auditLogs AuditLog[]
  opportunityStageChanges OpportunityStageHistory[]
  salesGoals         SalesGoal[] @relation("SalesGoalUser")
  salesGoalsUpdated  SalesGoal[] @relation("SalesGoalUpdatedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  segment        String?
  website        String?
  phone          String?
  email          String?
  revenue        Float?
  employees      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  saleiaMeetings SaleiaMeeting[]

  @@index([organizationId])
  @@map("companies")
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  name           String
  email          String?
  phone          String?
  role           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id])
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  saleiaMeetings SaleiaMeeting[]

  @@index([organizationId])
  @@map("contacts")
}

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  companyId      String?
  contactId      String?
  name           String
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NEW)
  score          Int        @default(0)
  notes          String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id])
  contact       Contact?      @relation(fields: [contactId], references: [id])
  opportunities Opportunity[]

  @@index([organizationId])
  @@map("leads")
}

model Opportunity {
  id             String           @id @default(cuid())
  organizationId String
  companyId      String?
  contactId      String?
  leadId         String?
  ownerId        String?
  pipelineId     String
  stageId        String
  title          String
  value          Decimal           @default(0) @db.Decimal(14, 2)
  /// Independente da etapa: ganha ou perdida continua na etapa em que fechou.
  status         OpportunityStatus @default(OPEN)
  probability    Int               @default(10)
  expectedClose  DateTime?
  lostReason     String?
  wonAt          DateTime?
  lostAt         DateTime?
  stageChangedAt DateTime         @default(now())
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // NoAction (checado ao fim do comando): apagar a organizacao remove tudo em cascata,
  // mas um funil ou etapa em uso nao pode ser apagado sozinho.
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: NoAction)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: NoAction)
  activities   Activity[]
  stageHistory OpportunityStageHistory[]
  saleiaMeetings SaleiaMeeting[]

  @@index([organizationId])
  @@index([organizationId, ownerId])
  @@index([pipelineId, stageId])
  @@map("opportunities")
}

// ─── FUNIS ───────────────────────────────────────────────────────────────────

/// Funil de vendas da organizacao. Toda organizacao tem um padrao.
model Pipeline {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  position       Int       @default(0)
  isDefault      Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([organizationId])
  @@map("pipelines")
}

/// Etapa de um funil. Etapa removida fica arquivada: o historico continua valido.
model PipelineStage {
  id             String    @id @default(cuid())
  organizationId String
  pipelineId     String
  name           String
  position       Int
  probability    Int
  /// Etapa de proposta: entra em "Propostas aguardando resposta" no Meu Dia.
  isProposal     Boolean   @default(false)
  /// Campos que a negociacao precisa ter para entrar nesta etapa (REQUIRABLE_FIELDS).
  requiredFields String[]  @default([])
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline      Pipeline                  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  historyFrom   OpportunityStageHistory[] @relation("HistoryFromStage")
  historyTo     OpportunityStageHistory[] @relation("HistoryToStage")

  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  companyId      String?
  contactId      String?
  opportunityId  String?
  /// Responsavel; o vendedor ve e altera apenas as proprias.
  ownerId        String?
  type           ActivityType
  title          String
  description    String?      @db.Text
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id])
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])
  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, ownerId, dueDate])
  @@map("activities")
}

/// Toda mudanca de etapa ou de status. Cada linha guarda o estado antes e depois.
model OpportunityStageHistory {
  id             String             @id @default(cuid())
  organizationId String
  opportunityId  String
  fromStageId    String?
  toStageId      String
  fromStatus     OpportunityStatus?
  toStatus       OpportunityStatus
  changedById    String?
  lostReason     String?
  changedAt      DateTime           @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  changedBy    User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)
  fromStage    PipelineStage? @relation("HistoryFromStage", fields: [fromStageId], references: [id], onDelete: NoAction)
  toStage      PipelineStage  @relation("HistoryToStage", fields: [toStageId], references: [id], onDelete: NoAction)

  @@index([opportunityId, changedAt])
  @@index([organizationId, changedAt])
  @@map("opportunity_stage_history")
}

// ─── METAS ───────────────────────────────────────────────────────────────────

/// Meta mensal de faturamento da organizacao (userId nulo) ou de um vendedor.
model SalesGoal {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  /// "ORG" ou o id do vendedor: garante uma unica meta por escopo e mes.
  scopeKey       String
  /// AAAA-MM, no fuso de Brasilia.
  month          String
  amount         Decimal  @db.Decimal(14, 2)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("SalesGoalUser", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("SalesGoalUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, month, scopeKey])
  @@map("sales_goals")
}

// ─── DIAGNÓSTICO ─────────────────────────────────────────────────────────────

model Diagnostic {
  id                String   @id @default(cuid())
  organizationId    String
  companyName       String
  segment           String
  revenue           String
  sellers           Int
  monthlyLeads      Int
  averageTicket     Float
  conversionRate    Float
  crmUsed           String?
  commercialProcess String?  @db.Text
  painPoints        String?  @db.Text
  maturityScore     Int      @default(0)
  bottlenecks       Json?
  recommendations   Json?
  financialImpact   Float?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("diagnostics")
}

// ─── PLANO DE AÇÃO ───────────────────────────────────────────────────────────

model ActionPlan {
  id             String     @id @default(cuid())
  organizationId String
  title          String
  objective      String
  status         PlanStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        ActionTask[]

  @@index([organizationId])
  @@map("action_plans")
}

model ActionTask {
  id           String     @id @default(cuid())
  actionPlanId String
  title        String
  description  String?    @db.Text
  responsible  String?
  dueDate      DateTime?
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  actionPlan ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  @@map("action_tasks")
}

// ─── INTEGRAÇÕES DE IA ────────────────────────────────────────────────────────

model ApiIntegration {
  id              String      @id @default(cuid())
  organizationId  String
  provider        ApiProvider
  apiKeyEncrypted String      @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("api_integrations")
}

// ─── SALEIA (V2-7) ────────────────────────────────────────────────────────────
// O SALE-IA envia reunioes analisadas (docs/INTEGRACAO_SALEIA.md). Uma
// instalacao do SALE-IA alimenta uma organizacao. O SOS e a fonte de verdade
// comercial: nada daqui muda negociacoes sozinho.

model SaleiaIntegration {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  /// Segredo HMAC compartilhado com o SALE-IA, criptografado (lib/security/crypto.ts).
  secretEncrypted String    @db.Text
  /// Ultimos 4 caracteres, para reconhecer o segredo na tela.
  secretHint      String
  lastEventAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("saleia_integrations")
}

model SaleiaMeeting {
  id              String    @id @default(cuid())
  organizationId  String
  /// Id da reuniao no SALE-IA; reenviar a mesma reuniao atualiza este registro.
  externalId      String
  title           String
  startedAt       DateTime
  durationMinutes Int?
  /// [{ name, email }]
  participants    Json
  summary         String    @db.Text
  companyId       String?
  contactId       String?
  opportunityId   String?
  /// Quando o SALE-IA concluiu a ultima analise.
  analyzedAt      DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  insights     SaleiaInsight[]

  @@unique([organizationId, externalId])
  @@index([organizationId, startedAt])
  @@index([companyId])
  @@index([opportunityId])
  @@map("saleia_meetings")
}

model SaleiaInsight {
  id             String              @id @default(cuid())
  organizationId String
  meetingId      String
  kind           SaleiaInsightKind
  text           String              @db.Text
  /// Trecho da conversa que sustenta o insight.
  quote          String?             @db.Text
  /// Etapa sugerida, pelo nome (STAGE_SUGGESTION).
  stageName      String?
  /// Prazo sugerido (RECOMMENDATION).
  dueDate        DateTime?
  /// Decisao humana (V2-7.3). Reenviar a reuniao so substitui os ainda OPEN.
  status         SaleiaInsightStatus @default(OPEN)
  position       Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      SaleiaMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([organizationId, kind, status])
  @@map("saleia_insights")
}

// ─── IA SDR ──────────────────────────────────────────────────────────────────

model SdrConversation {
  id             String             @id @default(cuid())
  organizationId String
  leadName       String?
  leadEmail      String?
  leadPhone      String?
  classification SdrLeadTemperature @default(COLD)
  consultantSeenAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     SdrMessage[]

  @@index([organizationId])
  @@map("sdr_conversations")
}

model SdrMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           SdrMessageRole
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  conversation SdrConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("sdr_messages")
}

// ─── CONSULTOR DIGITAL ─────────────────────────────────────────────────────────

model ConsultantConversation {
  id             String   @id @default(cuid())
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ConsultantMessage[]

  @@unique([organizationId])
  @@map("consultant_conversations")
}

model ConsultantMessage {
  id             String                @id @default(cuid())
  conversationId String
  role           ConsultantMessageRole
  content        String                @db.Text
  createdAt      DateTime              @default(now())

  conversation ConsultantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("consultant_messages")
}

// ─── AUDITORIA ───────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Plan {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  CONSULTANT
  MANAGER
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  FOLLOW_UP
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum SaleiaInsightKind {
  RECOMMENDATION
  OBJECTION
  BUYING_SIGNAL
  PAIN
  EVIDENCE
  STAGE_SUGGESTION
}

enum SaleiaInsightStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

enum ApiProvider {
  ANTHROPIC
  OPENAI
}

enum SdrMessageRole {
  LEAD
  ASSISTANT
}

enum SdrLeadTemperature {
  COLD
  WARM
  HOT
}

enum ConsultantMessageRole {
  USER
  ASSISTANT
}
